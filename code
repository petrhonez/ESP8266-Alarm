// DISPLAY
// ============================================================================
static void doisDig(char *b, uint8_t v) {
  b[0] = '0' + (v / 10);
  b[1] = '0' + (v % 10);
}

// Minuto do dia do próximo alarme armado, ou -1 se nenhum está armado.
// É o diagnóstico permanente: se um alarme não vai tocar, isso aparece aqui
// horas antes, em vez de no momento em que era para tocar.
int16_t proximoAlarme() {
  if (!rtcOk) return -1;
  uint16_t agoraMin = agoraRtc.hour() * 60 + agoraRtc.minute();
  int16_t melhor = -1;
  uint16_t menorDelta = 0xFFFF;

  for (uint8_t i = 0; i < N_ALARMES; i++) {
    if (sujo[i]) continue;
    if (cfg.alarmes[i].ir == IR_NADA && cfg.alarmes[i].buz == 0) continue;
    uint16_t m = cfg.alarmes[i].minuto;
    uint16_t d = (m >= agoraMin) ? (m - agoraMin) : (1440 - agoraMin + m);
    if (d < menorDelta) { menorDelta = d; melhor = (int16_t)m; }
  }
  return melhor;
}

static void montaLinha0(char *b) {
  memset(b, ' ', 16);

  if (pagina == 0) {
    b[0] = 'C';
    if (rtcOk) { doisDig(b + 2, agoraRtc.hour()); doisDig(b + 5, agoraRtc.minute()); }
    else       { b[2] = b[3] = b[5] = b[6] = '-'; }
    b[4] = ':';
    doisDig(b + 8, ajusteH); b[10] = ':'; doisDig(b + 11, ajusteM);
    b[14] = 'S';
    b[15] = 'Z';
  } else if (pagina <= 3) {
    uint8_t i = pagina - 1;
    b[0] = '0' + pagina;
    doisDig(b + 2, cfg.alarmes[i].minuto / 60);
    b[4] = ':';
    doisDig(b + 5, cfg.alarmes[i].minuto % 60);
    memcpy(b + 8, irNome[cfg.alarmes[i].ir], 3);
    b[12] = cfg.alarmes[i].buz ? 'S' : '-';
    b[15] = sujo[i] ? '*' : (char)CH_CHECK;
  } else {
    b[0] = 'N';
    b[2] = '>';
    memcpy(b + 8, irNome[teste.ir], 3);
    b[12] = teste.buz ? 'S' : '-';
  }
}

static void montaLinha1(char *b, uint32_t agora) {
  memset(b, ' ', 16);

  if (estado == TOCANDO) {
    memcpy(b, "ALARME ", 7);
    b[7] = '1' + alarmeAtivo;
    return;
  }
  if (estado == TESTANDO) {
    memcpy(b, "TESTE", 5);
    return;
  }

  // Texto de situação só no campo de repouso, para não colidir com o cursor.
  if (campo == 0) {
    if (!rtcOk) {
      memcpy(b + 5, "SEM RTC", 7);
    } else if (pagina == 0) {
      int16_t p = proximoAlarme();
      memcpy(b + 5, "prox ", 5);
      if (p < 0) { memcpy(b + 10, "--:--", 5); }
      else { doisDig(b + 10, p / 60); b[12] = ':'; doisDig(b + 13, p % 60); }
    }
  }

  // Cursor piscando. Com a página travada ele fica fixo, sinalizando a trava.
  bool mostra = travada ? true : ((agora % 700) < 420);
  if (mostra) b[colunaCursor(pagina, campo)] = (char)CH_SETA;
}

// Escreve só as células que mudaram desde o último desenho. Isso corta o
// tráfego no barramento I2C, que é compartilhado com o RTC.
static void escreveLinha(uint8_t linha, const char *novo, char *cacheLinha) {
  uint8_t i = 0;
  while (i < 16) {
    if (novo[i] == cacheLinha[i]) { i++; continue; }
    lcd.setCursor(i, linha);
    while (i < 16 && novo[i] != cacheLinha[i]) {
      lcd.write((uint8_t)novo[i]);
      cacheLinha[i] = novo[i];
      i++;
    }
  }
}

void desenha(uint32_t agora) {
  if ((uint32_t)(agora - marcaDesenho) < 120) return;
  marcaDesenho = agora;

  char l0[16], l1[16];
  montaLinha0(l0);
  montaLinha1(l1, agora);

  escreveLinha(0, l0, cache0);
  escreveLinha(1, l1, cache1);
}
